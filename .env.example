# Local admin scripts only (scripts/*.py). The GitHub Actions workflow does NOT
# use this file — it reads ALKOSTO_USERNAME / ALKOSTO_PASSWORD from repo secrets.
# Copy to .env (git-ignored) and fill in. Never commit real keys: the repo is public.

# Alkosto datafeed (only needed to run process_alkosto_products.py locally)
ALKOSTO_USERNAME=
ALKOSTO_PASSWORD=

# Algolia application (region US)
ALGOLIA_APP_ID=QX5IPS1B1Q

# Key restricted to the main Yalo index — ACL: search, browse, addObject, deleteObject,
# settings, editSettings, listIndexes. Used for Yalo_computadores_tables_monitores_impresores_pantallas.
ALGOLIA_ADMIN_API_KEY=
ALGOLIA_INDEX_NAME=Yalo_computadores_tables_monitores_impresores_pantallas

# Key restricted to the wildcard "agent_studio_*" — same ACL plus deleteIndex.
# Covers every current and future Agent Studio index.
ALGOLIA_AGENT_KEY=
